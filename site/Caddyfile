# Static file server for the Softcap landing page. kamal-proxy terminates TLS and forwards plain
# HTTP here on :80, so there is no TLS config in this file.
:80 {
	root * /srv
	encode zstd gzip

	# The page is one document with its styles inline; what is separate is the mark, the social
	# preview and the gallery's photographs, and none of them changes without its name changing
	# in the same commit. Named one by one until the gallery arrived — four screenshots would
	# have been four more lines and the next set four after that, so the directory is matched
	# instead. They shipped with no Cache-Control at all for one deploy, which is the shape of
	# mistake the check below now refuses.
	header /icon.svg Cache-Control "public, max-age=604800"
	header /og.png Cache-Control "public, max-age=604800"
	header /favicon.ico Cache-Control "public, max-age=604800"
	header /shots/* Cache-Control "public, max-age=604800"
	# `/clock.js` does not get the week those four get. Its name never changes and its contents
	# can, and it reads markup out of the page beside it — a cached script meeting a newer
	# document paints half a scene. The page is `no-cache` for the same reason and the file
	# is four and a half kilobytes: one revalidation, rather than a stale bug nobody can repeat.
	header /clock.js Cache-Control "no-cache"
	# Every spelling of every page. A `header` matcher tests the request path;
	# the site is now a tree of directories each holding an index.html, and a
	# reader arrives at `/`, `/ru/`, `/privacy/` — or, typing precisely, at the
	# file itself. Four shapes cover all of them, so no HTML answer is ever left
	# to the browser's caching heuristic. The assets above keep their week.
	@page path / */ /index.html */index.html
	header @page Cache-Control "no-cache"

	# The page loads no font, embeds no frame and posts no form, so the policy names exactly what
	# it uses. What it uses now includes one script: `/clock.js` puts the real time into the hero's
	# mock, and `script-src 'self'` is the narrowest grant that lets it run — this origin's own
	# files, no inline code, no other host. `unsafe-inline` for styles stays unavoidable while the
	# CSS lives in the document, which is the point of shipping one file; inline script is still
	# refused, so an injected style still has nothing to cooperate with.
	header {
		Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; script-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		X-Frame-Options "DENY"
		-Server
	}

	# HSTS is deliberately absent. It is the one header a browser remembers, and it would commit
	# this domain to HTTPS for everyone who has visited — a promise to make on purpose, not as a
	# side effect of hardening a landing page. The HTTP→HTTPS redirect already covers the ordinary
	# case.

	# No fallback to index.html: this is one page, not a single-page application.
	# Falling back would answer every unknown path with 200 and the landing page —
	# a soft 404, which search engines treat as a page that exists and a reader
	# treats as a site that lost their link silently.
	file_server

	# A miss used to answer with nothing at all: status 404, zero bytes, none of
	# the headers above, and `Server: Caddy` announced despite the `-Server` four
	# lines up. The header block never reaches a response `file_server` produces
	# by not finding a file, so the hardening applied to every path that exists
	# and to no path that does not — the same shape as the caching rule that was
	# written for `/index.html` while everybody arrives at `/`.
	#
	# `handle_errors` is a route of its own, so the headers have to be repeated
	# here. Kept to the four that mean something on a page with no content of its
	# own, plus the sign-off.
	handle_errors {
		header {
			Content-Security-Policy "default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			X-Frame-Options "DENY"
			-Server
		}
		respond "{err.status_code} {err.status_text} — softcap.app has one page, and this is not it." {err.status_code}
	}

	log {
		output stderr
		format console
	}
}
